# ==============================================================================
# InduSense — environment configuration template
# Copy to .env and adjust. Never commit the real .env file.
# ==============================================================================

# ---- General ----
ENVIRONMENT=development
LOG_LEVEL=info

# ---- PostgreSQL (transactional metadata) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=indusense
POSTGRES_USER=indusense
POSTGRES_PASSWORD=indusense_dev_password
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=5

# ---- Redis (cache / rate limiting / idempotency support) ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---- MQTT (Eclipse Mosquitto) ----
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_CLIENT_ID_PREFIX=indusense
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1

# ---- Kafka ----
KAFKA_BROKERS=kafka:9092
KAFKA_CONSUMER_GROUP_PREFIX=indusense
KAFKA_TOPIC_TELEMETRY_RAW=telemetry.raw
KAFKA_TOPIC_TELEMETRY_PROCESSED=telemetry.processed
KAFKA_TOPIC_ANOMALIES_DETECTED=anomalies.detected
KAFKA_TOPIC_ALERTS=alerts
KAFKA_TOPIC_INCIDENTS=incidents
KAFKA_TOPIC_DEVICE_EVENTS=device.events
KAFKA_TOPIC_AUDIT_EVENTS=audit.events
KAFKA_TOPIC_DEAD_LETTER=dead-letter
KAFKA_TELEMETRY_PARTITIONS=12
KAFKA_TELEMETRY_REPLICATION_FACTOR=1

# ---- InfluxDB (time-series telemetry) ----
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_ORG=indusense
INFLUXDB_BUCKET=telemetry
INFLUXDB_TOKEN=dev-only-influx-admin-token-change-me
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=indusense_dev_password

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=change-me-dev-only-access-secret
JWT_REFRESH_SECRET=change-me-dev-only-refresh-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ---- API service ----
API_PORT=8080
API_CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Ingestion service ----
INGESTION_PORT=8081
INGESTION_WORKER_POOL_SIZE=50
INGESTION_QUEUE_CAPACITY=10000

# ---- Stream processor ----
STREAM_PROCESSOR_PORT=8082

# ---- Anomaly detector ----
ANOMALY_DETECTOR_PORT=8083

# ---- Alert service ----
ALERT_SERVICE_PORT=8084

# ---- Sensor simulator ----
SENSOR_COUNT=1000
MESSAGES_PER_SECOND=1000
ANOMALY_RATE=0.02
DUPLICATE_RATE=0.01
OUT_OF_ORDER_RATE=0.02
NETWORK_DELAY_RATE=0.03
SENSOR_FAILURE_RATE=0.005

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
PROMETHEUS_METRICS_PORT=9090
